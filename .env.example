# ---------- Postgres ----------
# Host port for psql access. Services talk to `postgres:5432` internally, so
# change this freely if 5432 is already in use on your machine.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_APP_DB=frontflow
POSTGRES_SUPERSET_DB=superset
# Read-only role Superset uses to query application data
SUPERSET_RO_USER=superset_ro
SUPERSET_RO_PASSWORD=change-me-readonly

# ---------- Backend ----------
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres@postgres:5432/frontflow
CORS_ORIGINS=http://localhost:5173

# ---------- Superset ----------
SUPERSET_PORT=8088
SUPERSET_URL=http://superset:8088
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-admin
SUPERSET_ADMIN_EMAIL=admin@example.com
GUEST_TOKEN_JWT_SECRET=change-me-to-another-long-random-string

# OPTIONAL. The dashboard binding (embed UUID + refresh filter) is normally
# set from the Setup panel in the app and stored in the database, so there is
# nothing to put here and no restart needed to change it.
#
# This variable only seeds the binding on a cold database, for automated
# deployments that want to skip the setup step. It is the UUID from Superset's
# "Embed dashboard" config, NOT the numeric dashboard id.
SUPERSET_DASHBOARD_EMBED_UUID=

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPERSET_DOMAIN=http://localhost:8088
